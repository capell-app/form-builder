{
    "manifest-version": 3,
    "name": "capell-app/form-builder",
    "slug": "form-builder",
    "displayName": "Form Builder",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "preview",
    "description": "Build your own contact, quote and application forms, with answers arriving in an admin inbox you can reply from.",
    "product": {
        "group": "Capell Engagement & CRM",
        "tier": "premium",
        "bundle": "engagement-crm"
    },
    "namespace": "Capell\\FormBuilder",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/layout-builder",
            "capell-app/payments",
            "capell-app/privacy-center"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [
            "Capell\\FormBuilder\\Providers\\MigrationMetadataServiceProvider"
        ],
        "install": [],
        "runtime": [
            "Capell\\FormBuilder\\Providers\\FormBuilderServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-resource",
            "class": "Capell\\FormBuilder\\Manifest\\FormResourceContribution",
            "resourceClass": "Capell\\FormBuilder\\Filament\\Resources\\Forms\\FormResource"
        },
        {
            "type": "admin-resource",
            "class": "Capell\\FormBuilder\\Manifest\\SubmissionResourceContribution",
            "resourceClass": "Capell\\FormBuilder\\Filament\\Resources\\Submissions\\SubmissionResource"
        },
        {
            "type": "frontend-component",
            "class": "Capell\\FormBuilder\\Manifest\\FormElementComponentContribution",
            "componentClass": "Capell\\FormBuilder\\Livewire\\FormElementComponent",
            "surface": "frontend"
        },
        {
            "type": "configurator",
            "class": "Capell\\FormBuilder\\Manifest\\FormBuilderWidgetConfiguratorContribution",
            "configuratorClasses": [
                "Capell\\FormBuilder\\Bridges\\LayoutBuilder\\FormBuilderFormWidgetConfigurator"
            ],
            "groups": ["Widget"]
        },
        {
            "type": "route",
            "class": "Capell\\FormBuilder\\Manifest\\FormBuilderPaymentRoutesContribution",
            "routes": [
                "capell-payments.form-builder.checkout",
                "capell-payments.form-builder.selected-checkout"
            ]
        },
        {
            "type": "model",
            "class": "Capell\\FormBuilder\\Manifest\\FormModelContribution",
            "modelClass": "Capell\\FormBuilder\\Models\\Form"
        },
        {
            "type": "model",
            "class": "Capell\\FormBuilder\\Manifest\\SubmissionModelContribution",
            "modelClass": "Capell\\FormBuilder\\Models\\Submission"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\FormBuilder\\Manifest\\FormBuilderPruneScheduleContribution",
            "key": "form-builder-submission-prune",
            "command": "capell:form-builder:prune",
            "frequency": "daily"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\FormBuilder\\Manifest\\FormBuilderDeliveryRecoveryScheduleContribution",
            "key": "form-builder-delivery-recovery",
            "command": "capell:form-builder:recover-deliveries",
            "frequency": "everyFiveMinutes"
        },
        {
            "type": "console-command",
            "class": "Capell\\FormBuilder\\Manifest\\FormBuilderConsoleCommandsContribution",
            "commands": [
                "capell:form-builder:export-submissions",
                "capell:form-builder:prune",
                "capell:form-builder:recover-deliveries"
            ],
            "commandClasses": [
                "Capell\\FormBuilder\\Console\\Commands\\ExportSubmissionsCommand",
                "Capell\\FormBuilder\\Console\\Commands\\PruneExpiredFormSubmissionsCommand",
                "Capell\\FormBuilder\\Console\\Commands\\RecoverSubmissionDeliveriesCommand"
            ],
            "excludedCommands": {
                "capell:form-builder-screenshot-fixture": "Seeds disposable screenshot data only; not an operational command."
            }
        }
    ],
    "database": {
        "migrations": true,
        "settings": false,
        "requiredTables": ["forms", "submissions"]
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "prune": "capell:form-builder:prune",
        "exportSubmissions": "capell:form-builder:export-submissions",
        "recoverDeliveries": "capell:form-builder:recover-deliveries"
    },
    "actions": {
        "archiveSubmission": "Capell\\FormBuilder\\Actions\\ArchiveSubmissionAction",
        "buildFormSteps": "Capell\\FormBuilder\\Actions\\BuildFormStepsAction",
        "buildSubmissionPayloadData": "Capell\\FormBuilder\\Actions\\BuildSubmissionPayloadDataAction",
        "buildFormValidationRules": "Capell\\FormBuilder\\Actions\\BuildFormValidationRulesAction",
        "calculateFormFieldValues": "Capell\\FormBuilder\\Actions\\CalculateFormFieldValuesAction",
        "calculateSubmissionSpamScore": "Capell\\FormBuilder\\Actions\\CalculateSubmissionSpamScoreAction",
        "createFormPaymentCheckoutRedirectUrl": "Capell\\FormBuilder\\Actions\\CreateFormPaymentCheckoutRedirectUrlAction",
        "createFormPaymentCheckoutUrl": "Capell\\FormBuilder\\Actions\\CreateFormPaymentCheckoutUrlAction",
        "createFormPaymentCheckout": "Capell\\FormBuilder\\Bridges\\Payments\\CreateFormPaymentCheckoutSessionAction",
        "createSubmission": "Capell\\FormBuilder\\Actions\\CreateSubmissionAction",
        "dispatchUnstoredFormSubmission": "Capell\\FormBuilder\\Actions\\DispatchUnstoredFormSubmissionAction",
        "evaluateFormFieldVisibility": "Capell\\FormBuilder\\Actions\\EvaluateFormFieldVisibilityAction",
        "markSubmissionRead": "Capell\\FormBuilder\\Actions\\MarkSubmissionReadAction",
        "markSubmissionSpam": "Capell\\FormBuilder\\Actions\\MarkSubmissionSpamAction",
        "replyToSubmission": "Capell\\FormBuilder\\Actions\\ReplyToSubmissionAction",
        "resolveVisibleFormFields": "Capell\\FormBuilder\\Actions\\ResolveVisibleFormFieldsAction",
        "sendSubmissionNotification": "Capell\\FormBuilder\\Actions\\SendSubmissionNotificationAction",
        "buildFormAgentToolManifest": "Capell\\FormBuilder\\Actions\\BuildFormAgentToolManifestAction"
    },
    "settings": [],
    "permissions": [
        "ViewAny:Form",
        "View:Form",
        "Create:Form",
        "Update:Form",
        "Delete:Form",
        "DeleteAny:Form",
        "Restore:Form",
        "RestoreAny:Form",
        "ForceDelete:Form",
        "ForceDeleteAny:Form",
        "Reorder:Form",
        "ViewAny:Submission",
        "View:Submission",
        "Reply:Submission",
        "Update:Submission",
        "Delete:Submission",
        "DeleteAny:Submission",
        "Export:Submission"
    ],
    "capabilities": [
        "form-builder",
        "form-builder-admin",
        "form-builder-frontend",
        "public-form",
        "requires-livewire",
        "cache-blocking"
    ],
    "agent_tools": [
        {
            "name": "form.submit",
            "description": "Submit this public form after user confirmation.",
            "inputSchema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
            },
            "outputSchema": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": ["submitted", "pending"]
                    },
                    "cancelled": {
                        "type": "boolean"
                    }
                },
                "required": ["status"],
                "additionalProperties": false
            },
            "effect": "write",
            "binding": {
                "type": "form",
                "target": "capell-form"
            }
        }
    ],
    "security": {
        "riskTier": "sensitive",
        "publicSurface": {
            "routeNames": [
                "GET /capell/payments/forms/{submission}/checkout (capell-payments.form-builder.checkout)",
                "GET /capell/payments/forms/{submission}/selected-checkout (capell-payments.form-builder.selected-checkout)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [
                "GET /capell/payments/forms/{submission}/checkout (capell-payments.form-builder.checkout)",
                "GET /capell/payments/forms/{submission}/selected-checkout (capell-payments.form-builder.selected-checkout)"
            ],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /capell/payments/forms/{submission}/checkout (capell-payments.form-builder.checkout)",
                "GET /capell/payments/forms/{submission}/selected-checkout (capell-payments.form-builder.selected-checkout)"
            ]
        },
        "throttles": {
            "capell-form-builder-submit": {
                "maxAttempts": 12,
                "decaySeconds": 60,
                "routes": []
            },
            "capell-form-builder-checkout": {
                "maxAttempts": 10,
                "decaySeconds": 60,
                "routes": [
                    "GET /capell/payments/forms/{submission}/checkout (capell-payments.form-builder.checkout)",
                    "GET /capell/payments/forms/{submission}/selected-checkout (capell-payments.form-builder.selected-checkout)"
                ]
            }
        },
        "sensitiveData": {
            "encryptedFields": [
                "Capell\\FormBuilder\\Models\\Submission::$meta",
                "Capell\\FormBuilder\\Models\\Submission::$payload"
            ],
            "hashedTokenFields": ["submissions.subject_email_hash"],
            "redactedOutputClasses": [
                "Capell\\FormBuilder\\Actions\\DispatchSubmissionWebhookAction",
                "Capell\\FormBuilder\\Actions\\RedactSubmissionWebhookErrorMessageAction"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\FormBuilder\\Actions\\DispatchSubmissionWebhookAction",
                "Capell\\FormBuilder\\Support\\SpamProtection\\TurnstileSpamProtectionProvider"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": [
                "ViewAny:Form",
                "View:Form",
                "Create:Form",
                "Update:Form",
                "Delete:Form",
                "DeleteAny:Form",
                "Restore:Form",
                "RestoreAny:Form",
                "ForceDelete:Form",
                "ForceDeleteAny:Form",
                "Reorder:Form",
                "ViewAny:Submission",
                "View:Submission",
                "Reply:Submission",
                "Update:Submission",
                "Delete:Submission",
                "DeleteAny:Submission",
                "Export:Submission"
            ]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["form-builder"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": [],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\FormBuilder\\Models\\Form",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "form-builder.validation",
            "label": "Public submissions are validated from typed field schema",
            "class": "Capell\\FormBuilder\\Health\\FormBuilderHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "form-builder.spam-honeypot",
            "label": "Triggered honeypot submissions are recorded as spam without dispatching workflows",
            "class": "Capell\\FormBuilder\\Health\\FormBuilderHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "form-builder.encrypted-submissions",
            "label": "Submission payload and metadata remain encrypted at rest",
            "class": "Capell\\FormBuilder\\Health\\FormBuilderHealthCheck",
            "severity": "warning",
            "surface": "admin"
        },
        {
            "key": "form-builder.submission-retention",
            "label": "Expired submissions are pruned while legal holds remain protected",
            "class": "Capell\\FormBuilder\\Health\\FormBuilderHealthCheck",
            "severity": "warning",
            "surface": "admin"
        }
    ],
    "commercial": {
        "proposedLicense": "paid",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Forms with questions that change with earlier answers, steps, file uploads, auto-replies and an inbox that sorts spam.",
        "description": "Make the contact, quote and application forms your business needs, and read every answer in an inbox in your admin. A form can email your team and thank the visitor automatically. Questions can appear after a certain answer, visitors can attach files, and a long form can run over several steps. Each enquiry gets a spam score, and the worst are moved to Spam, with a hidden trap field available for basic bots. Typed answers are stored encrypted and removed after a year unless held for legal reasons. Place a form with the Form element in the page editor, then reply from the inbox.",
        "problem": "Enquiries go missing in someone's inbox, spam fills the form, and one-size forms ask the wrong questions.",
        "outcome": "Every enquiry lands in one inbox, spam is set aside, and you reply by email from the admin.",
        "faq": [
            {
                "question": "Where do the answers people send end up?",
                "answer": "In an inbox inside your admin, where you reply to each enquiry by email and archive it once it's dealt with. Each form can also email your staff and send the visitor an automatic thank-you."
            },
            {
                "question": "Does a saved form appear on my site by itself?",
                "answer": "No. A saved form still has to be put on a page. With Layout Builder you add it as a widget and choose the form, and otherwise your developer places it."
            },
            {
                "question": "Can a form ask different questions depending on earlier answers?",
                "answer": "Yes. Choosing Kitchen on a quote form can bring up the worktop questions, longer forms can be split into steps, and a field can work out a total from other answers."
            },
            {
                "question": "How does it deal with spam?",
                "answer": "Each enquiry is scored for signs of spam such as too many links, repeated answers and blocked words. High scorers are moved to Spam, and you can add a hidden trap field to catch simple bots."
            },
            {
                "question": "How long are enquiries kept?",
                "answer": "Answers are stored encrypted and deleted after a year, unless you put an enquiry on legal hold to keep it longer."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card titled Form Builder with a blank site page and an empty list of form mappings beside a three-step diagram",
                "caption": "The card that represents Form Builder on its Marketplace listing."
            },
            {
                "path": "docs/screenshots/create-edit-form-schema-screen.png",
                "alt": "Edit page for a form called Product feedback with site, name, active switch and description above a section for its fields",
                "caption": "Each form has its own page where you name it, switch it on and set up its fields."
            },
            {
                "path": "docs/screenshots/submissions-index.png",
                "alt": "Submissions inbox with four project enquiries marked New, Read or Archived, each with actions such as Archive and Mark spam",
                "caption": "Mark enquiries read, archive them, put one on legal hold or flag it as spam."
            },
            {
                "path": "docs/screenshots/frontend-form-output.png",
                "alt": "Demo page with a filled-in enquiry form and a Send enquiry button beside a panel of notes written for developers",
                "caption": "Visitors fill in the fields and press Send enquiry."
            }
        ],
        "categories": ["admin", "form-builder", "frontend"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "admin-action-extender",
                "key": "marketing-action:form-builder.forms",
                "providerBucket": "runtime"
            },
            {
                "type": "admin-action-extender",
                "key": "marketing-action:form-builder.submissions",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "component:Widget:FormBuilderForm",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:form-field:capell-form-builder::element.form",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-block:capell-form-builder::block.form",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "renderable:layout-widget:capell-form-builder::widget.form",
                "providerBucket": "runtime"
            }
        ]
    },
    "install": {
        "tips": [
            {
                "variant": "package_form_builder",
                "priority": 20
            }
        ]
    }
}
