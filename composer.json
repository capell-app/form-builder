{
    "name": "capell-app/form-builder",
    "description": "Form builder for Capell with conditional fields, steps, uploads, totals, spam scoring, encrypted answers and an admin inbox for replies and archiving.",
    "keywords": [
        "capell",
        "form-builder",
        "laravel",
        "filamentphp",
        "cms"
    ],
    "homepage": "https://github.com/capell-app/form-builder",
    "license": "proprietary",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.78",
        "capell-app/core": "^1.0.79",
        "capell-app/frontend": "^1.0"
    },
    "conflict": {
        "capell-app/privacy-center": "<1.1.10"
    },
    "suggest": {
        "capell-app/layout-builder": "Lets editors place a form on a page as a Layout Builder widget.",
        "capell-app/payments": "Enables payment fields and checkout for form submissions.",
        "capell-app/privacy-center": "Holds form submissions that only mention a person for review when they ask to be forgotten."
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\FormBuilder\\": "src/",
            "Capell\\FormBuilder\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\FormBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\FormBuilder\\Providers\\FormBuilderServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    },
    "prefer-stable": true,
    "type": "library",
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/form-builder"
    }
}
